#!/usr/bin/env bash


SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

VERSION=$(<"$PROJECT_ROOT/version.txt")
echo "linux-update $VERSION"
echo "Detected package manager: $PACKAGE_MANAGER"
echo "Running system update..."

# shellcheck disable=SC1091
source "$PROJECT_ROOT/lib/osdetect.sh"

detect_package_manager

echo "Package manager: $PACKAGE_MANAGER"

#  out manager pacman & apk
case "$PACKAGE_MANAGER" in
apt)
	# shellcheck disable=SC1091
	source "$PROJECT_ROOT/lib/apt.sh"
	update_system
	;;
dnf)
	# shellcheck disable=SC1091
	source "$PROJECT_ROOT/lib/dnf.sh"
	update_system
	;;
zypper)
	# shellcheck disable=SC1091
	source "$PROJECT_ROOT/lib/zypper.sh"
	update_system
	;;
esac
