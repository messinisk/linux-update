#!/usr/bin/env bash

###############################################################################
# linux-update
#
# Development mode:
#
#   repo/
#   ├── bin/linux-update
#   ├── lib/
#   └── version.txt
#
# Installed mode:
#
#   /usr/bin/linux-update
#   /usr/lib/linux-update/
#       apt.sh
#       dnf.sh
#       osdetect.sh
#       self-update.sh
#       version.txt
#
###############################################################################

###############################################################################
# Runtime path detection
###############################################################################

if [ -f /usr/lib/linux-update/version.txt ]
then

    INSTALLED_MODE=1

    PROJECT_ROOT="/usr/lib/linux-update"

    LIB_DIR="/usr/lib/linux-update"

else
	# shellcheck disable=SC2034
    INSTALLED_MODE=0

    SCRIPT_DIR="$(
        cd "$(dirname "${BASH_SOURCE[0]}")" \
        && pwd
    )"

    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

    LIB_DIR="$PROJECT_ROOT/lib"

fi

###############################################################################
# Version
###############################################################################

VERSION=$(<"$PROJECT_ROOT/version.txt")

echo "linux-update $VERSION"

###############################################################################
# Self update
###############################################################################

case "${1:-}" in

    self-update)

        # shellcheck disable=SC1091
        source "$LIB_DIR/self-update.sh"

        self_update

        exit 0
        ;;

esac

###############################################################################
# Normal system update flow
###############################################################################

echo "Running system update..."

# shellcheck disable=SC1091
source "$LIB_DIR/osdetect.sh"

detect_package_manager

echo "Package manager: $PACKAGE_MANAGER"

###############################################################################
# Invoke package manager implementation
###############################################################################

case "$PACKAGE_MANAGER" in

    apt)

        # shellcheck disable=SC1091
        source "$LIB_DIR/apt.sh"

        update_system
        ;;

    dnf)

        # shellcheck disable=SC1091
        source "$LIB_DIR/dnf.sh"

        update_system
        ;;

    zypper)

        # shellcheck disable=SC1091
        source "$LIB_DIR/zypper.sh"

        update_system
        ;;

    *)

        echo "Unsupported package manager"

        exit 1
        ;;

esac