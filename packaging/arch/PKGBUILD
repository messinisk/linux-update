#!/usr/bin/env bash

# shellcheck disable=SC2034
pkgname=linux-update
pkgver=0.1.0
pkgrel=1
pkgdesc="Universal Linux update utility"
arch=('any')
license=('Apache 2')


package() {
    # shellcheck disable=SC2154
    install -d "$pkgdir/usr/bin"
    install -d "$pkgdir/usr/lib/"

    install -m755 "$PWD/../../bin/linux-update" \
        "$pkgdir/usr/bin/"

    install -m644 "$PWD/../../lib/"*.sh \
        "$pkgdir/usr/lib/"
}