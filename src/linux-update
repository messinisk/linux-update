#!/usr/bin/env bash

###############################################################################
# linux-update
#
# Development mode:
#
#   repo/
#   ├── bin/linux-update
#   ├── lib/
#   └── version.txt
#
# Installed mode:
#
#   /usr/bin/linux-update
#   /usr/lib/linux-update/
#       apt.sh
#       dnf.sh
#       osdetect.sh
#       self-update.sh
#       version.txt
#
###############################################################################

###############################################################################
# Runtime path detection
###############################################################################
###############################################################################
# Runtime path detection (Supports System, AppImage, and Local Dev)
###############################################################################

# shellcheck disable=SC2128
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE}")" && pwd)"

REPO_ROOT="$(dirname "$SCRIPT_DIR")"

if [ -f "$REPO_ROOT/src/system/osdetect.sh" ]; then

    INSTALLED_MODE=0

    PROJECT_ROOT="$REPO_ROOT"

    LIB_DIR="$PROJECT_ROOT/src/system"

    COMMAND_DIR="$PROJECT_ROOT/src/commands"

elif [ -n "${APPIMAGE+x}" ] && [ -d "$APPDIR" ]; then

    INSTALLED_MODE=1

    PROJECT_ROOT="$APPDIR/usr/lib/linux-update"

    LIB_DIR="$PROJECT_ROOT"

    COMMAND_DIR="$PROJECT_ROOT"

elif [ -f /usr/lib/linux-update/version.txt ]; then

    # shellcheck disable=SC2034
    INSTALLED_MODE=1

    PROJECT_ROOT="/usr/lib/linux-update"

    LIB_DIR="$PROJECT_ROOT"

    COMMAND_DIR="$PROJECT_ROOT"

else

    echo "Cannot locate runtime files"
    exit 1

fi


###############################################################################
# Version
###############################################################################

VERSION=$(<"$PROJECT_ROOT/version.txt")

echo "linux-update $VERSION"

###############################################################################
# Self update
###############################################################################

case "${1:-}" in

    self-update)
        export PROJECT_ROOT
        export LIB_DIR
        export COMMAND_DIR
        # shellcheck disable=SC1091
        source "$COMMAND_DIR/self-update.sh"
        exit 0
        ;;

esac

###############################################################################
# Normal system update flow
###############################################################################

echo "Running system update..."

# shellcheck disable=SC1091
source "$LIB_DIR/osdetect.sh"

detect_package_manager

echo "Package manager: $PACKAGE_MANAGER"

###############################################################################
# Invoke package manager implementation
###############################################################################

case "$PACKAGE_MANAGER" in

    apt)
        # shellcheck disable=SC1091
        source "$LIB_DIR/apt.sh"

        info_apt
        ;;

    dnf)

        # shellcheck disable=SC1091
        source "$LIB_DIR/dnf.sh"

        info_dnf
        ;;

    zypper)

        # shellcheck disable=SC1091
        source "$LIB_DIR/zypper.sh"

        info_zypper
        ;;

    *)

        echo "Unsupported package manager"

        exit 1
        ;;

esac