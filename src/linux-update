#!/usr/bin/env bash

###############################################################################
# linux-update
#
# Development mode:
#
#   repo/
#   ├── bin/linux-update
#   ├── lib/
#   └── version.txt
#
# Installed mode:
#
#   /usr/bin/linux-update
#   /usr/lib/linux-update/
#       apt.sh
#       dnf.sh
#       osdetect.sh
#       self-update.sh
#       version.txt
#
###############################################################################

###############################################################################
# Runtime path detection
###############################################################################
###############################################################################
# Runtime path detection (Supports System, AppImage, and Local Dev)
###############################################################################

if [ -n "${APPIMAGE+x}" ] && [ -d "$APPDIR" ]; then
    # 1. Mode: AppImage
    INSTALLED_MODE=1
    # Ορίζουμε το PROJECT_ROOT και το LIB_DIR να δείχνουν ακριβώς εκεί που 
    # το builder script σου αντιγράφει τα αρχεία (.sh και version.txt)
    PROJECT_ROOT="$APPDIR/usr/lib/linux-update"
    LIB_DIR="$APPDIR/usr/lib/linux-update"

elif [ -f /usr/lib/linux-update/version.txt ]; then
    # 2. Mode: Κανονική εγκατάσταση στο σύστημα (.deb / .rpm)
    INSTALLED_MODE=1
    PROJECT_ROOT="/usr/lib/linux-update"
    LIB_DIR="/usr/lib/linux-update"

else
    # 3. Mode: Τοπική ανάπτυξη (Local Development / Git repo)
    # shellcheck disable=SC2034
    INSTALLED_MODE=0
    # shellcheck disable=SC2128
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE}")" && pwd)"
    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
    LIB_DIR="$PROJECT_ROOT/src/system"
fi



###############################################################################
# Version
###############################################################################

VERSION=$(<"$LIB_DIR/version.txt")

echo "linux-update $VERSION"

###############################################################################
# Self update
###############################################################################

case "${1:-}" in

    self-update)
        # shellcheck disable=SC1091
        source "$LIB_DIR/self-update.sh"
        # self_update  <-- Διαγραφή ή σχόλιο εδώ
        exit 0
        ;;

esac

###############################################################################
# Normal system update flow
###############################################################################

echo "Running system update..."

# shellcheck disable=SC1091
source "$LIB_DIR/osdetect.sh"

detect_package_manager

echo "Package manager: $PACKAGE_MANAGER"

###############################################################################
# Invoke package manager implementation
###############################################################################

case "$PACKAGE_MANAGER" in

    apt)

        # shellcheck disable=SC1091
        source "$LIB_DIR/apt.sh"

        update_system
        ;;

    dnf)

        # shellcheck disable=SC1091
        source "$LIB_DIR/dnf.sh"

        update_system
        ;;

    zypper)

        # shellcheck disable=SC1091
        source "$LIB_DIR/zypper.sh"

        update_system
        ;;

    *)

        echo "Unsupported package manager"

        exit 1
        ;;

esac